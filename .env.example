# App
APP_NAME=NaijaHealth
APP_VERSION=1.0.0

# Postgres (async DSN — uses asyncpg driver)
POSTGRES_DSN=postgresql+asyncpg://naijahealth:naijahealth@localhost:5432/naijahealth

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=nh_embeddings
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=1024

# Cohere embedder (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0
EMBED_BATCH_SIZE=96

# Scraper
SCRAPER_OUTPUT_DIR=data

# Scheduler — daily scrape time (24h, local tz)
SCRAPE_HOUR=2
SCRAPE_MINUTE=0
RUN_PIPELINE_AFTER_SCRAPE=true
