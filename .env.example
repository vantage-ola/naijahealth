# ── Required ────────────────────────────────────────────────────────────────

# Postgres (asyncpg DSN)
POSTGRES_DSN=postgresql+asyncpg://naijahealth:naijahealth@localhost:5432/naijahealth

# Qdrant
QDRANT_URL=http://localhost:6333

# Cohere — embed + generate (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=

# WhatsApp Cloud API (https://developers.facebook.com/apps)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=naijahealth_verify
WHATSAPP_WEBHOOK_SECRET=   # App Secret from Meta app settings → Basic

# ── Optional overrides (defaults shown) ─────────────────────────────────────

# QDRANT_API_KEY=                          # only if Qdrant is behind auth
# QDRANT_COLLECTION_NAME=nh_embeddings
# QDRANT_VECTOR_SIZE=1024

# COHERE_EMBED_MODEL=embed-multilingual-v3.0
# COHERE_GENERATE_MODEL=command-r-plus-08-2024
# EMBED_BATCH_SIZE=96
# RAG_TOP_K=5

# SCRAPER_OUTPUT_DIR=data
# SCRAPE_HOUR=2
# SCRAPE_MINUTE=0
# RUN_PIPELINE_AFTER_SCRAPE=true
